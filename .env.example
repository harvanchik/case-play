TURSO_DATABASE_URL=libsql://your-database-name.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
ADMIN_BOOTSTRAP_PASSWORD=replace-me-with-a-strong-password
SESSION_COOKIE_SECRET=replace-me-with-a-long-random-string
ACCOUNT_SESSION_SECRET=replace-me-with-a-different-long-random-string
PUBLIC_APP_ORIGIN=https://caseplay.org
GOOGLE_OAUTH_CLIENT_ID=replace-me
GOOGLE_OAUTH_CLIENT_SECRET=replace-me
MICROSOFT_OAUTH_CLIENT_ID=replace-me
MICROSOFT_OAUTH_CLIENT_SECRET=replace-me
# Use your verified Entra External ID issuer (the common endpoint is only a development placeholder).
MICROSOFT_OIDC_ISSUER=https://login.microsoftonline.com/common/v2.0

# Enable only after migration 0009, Workflow, Sandbox, and a PRIVATE Blob store are configured.
PLAY_BUILDER_VIDEO_EXPORT_ENABLED=false
# Optional prewarmed Sandbox snapshot containing Node 24, FFmpeg, and @resvg/resvg-js@2.6.2.
PLAY_BUILDER_VIDEO_SANDBOX_SNAPSHOT_ID=
# Private Blob store credentials are supplied by the linked Vercel store (OIDC or BLOB_READ_WRITE_TOKEN).
